{
  "name": "roamly-merchant-miniapp",
  "version": "0.1.0",
  "private": true,
  "description": "Roamly 商户经营与核销微信小程序",
  "scripts": {
    "build:npm": "node scripts/build-npm.cjs",
    "type-check": "tsc --noEmit",
    "lint": "eslint miniprogram tests",
    "lint:styles": "stylelint \"miniprogram/**/*.wxss\"",
    "format:check": "prettier --check .",
    "visual:check": "node scripts/visual-check.cjs",
    "test": "vitest run",
    "verify": "npm run type-check && npm run lint && npm run lint:styles && npm run test"
  },
  "dependencies": {
    "lottie-miniprogram": "1.0.12",
    "tdesign-miniprogram": "1.16.0"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "@types/node": "24.10.14",
    "eslint": "9.39.1",
    "globals": "17.4.0",
    "miniprogram-api-typings": "5.2.3",
    "miniprogram-automator": "^0.12.1",
    "miniprogram-ci": "2.1.31",
    "prettier": "3.8.1",
    "sharp": "^0.34.4",
    "stylelint": "16.23.1",
    "stylelint-config-standard": "39.0.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.69.0",
    "vitest": "4.0.18"
  }
}
