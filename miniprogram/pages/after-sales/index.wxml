<app-navbar title="处理售后" />
<view class="page-shell page-shell--subpage after-sales-page">
  <view class="page-heading">处理售后</view>
  <view class="page-copy">查看本店退款申请，资金处理由平台完成</view>
  <button class="primary-action" bindtap="openCreate">发起退款申请</button>
  <view wx:if="{{loading}}" class="state-panel"><t-loading size="42rpx" /> 正在加载售后</view>
  <view wx:elif="{{error}}" class="error-panel"><view>{{error}}</view><button class="text-action" bindtap="retry">重新加载</button></view>
  <view wx:elif="{{!items.length}}" class="state-panel">暂无售后记录</view>
  <view wx:else class="record-list">
    <view wx:for="{{items}}" wx:key="id" class="record-card surface-card">
      <view class="record-head"><view><view class="record-kicker">订单 {{item.orderId}}</view><view class="record-title">券 {{item.voucherId}}</view></view><view class="record-status">{{item.statusText}}</view></view>
      <view class="record-grid"><view><text>退款金额</text><strong>¥{{item.amountText}}</strong></view><view><text>申请时间</text><strong>{{item.timeText}}</strong></view></view>
      <view wx:if="{{item.reason}}" class="reversal-copy">{{item.reason}}</view>
    </view>
  </view>
</view>
