.field {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  margin-bottom: 24rpx;
  padding: 24rpx;
  background: #fff;
  border-radius: 16rpx;
}

.field text {
  color: #777680;
  font-size: 24rpx;
}

.field input,
.field textarea {
  width: 100%;
  box-sizing: border-box;
  font-size: 28rpx;
}
