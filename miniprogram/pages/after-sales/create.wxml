<app-navbar title="发起退款" back />
<view class="refund-create page-enter">
  <view class="refund-intro" wx:if="{{!candidate}}"><view class="refund-heading">请查找需要退款的订单</view><view class="refund-subheading">仅可对已支付且包含可退款未使用券的本店订单发起退款</view><view class="candidate-search"><t-icon name="search" size="46rpx" color="#9b99a3" /><input focus="{{true}}" value="{{keyword}}" placeholder="请输入订单编号、券码查询" confirm-type="search" bindinput="onKeyword" bindconfirm="searchCandidate" /></view><view class="help-line">找不到订单编号？<text bindtap="showHelp">帮助</text></view><button class="search-button" loading="{{searching}}" disabled="{{searching}}" bindtap="searchCandidate">搜索</button></view>
<view wx:else class="candidate-result"><view class="result-heading">选择退款券</view><view class="order-summary"><view class="order-summary__title">{{candidate.productTitle || '团购券订单'}}</view><view>订单 {{candidate.orderId}} · 共 {{candidate.quantity}} 张</view><view wx:if="{{candidate.payAmount !== undefined}}">实付 ¥{{payAmountText}}</view></view><view wx:if="{{!candidate.refundable}}" class="candidate-warning">{{candidate.unavailableReason || '当前订单没有可退款券'}}</view><view wx:else class="voucher-options"><view wx:for="{{candidate.vouchers}}" wx:key="id" class="voucher-option {{selectedIds[item.id] ? 'voucher-option--selected' : ''}} {{!item.refundable ? 'voucher-option--disabled' : ''}}" data-id="{{item.id}}" data-refundable="{{item.refundable}}" bindtap="toggleVoucher"><view class="voucher-check">{{selectedIds[item.id] ? '✓' : ''}}</view><view class="voucher-option__main"><view>券 {{item.sequenceNo}} · 券码 ****{{item.voucherCodeLast4 || '----'}}</view><view class="voucher-option__note">{{item.refundable ? '可申请退款' : item.unavailableReason}}</view></view><view class="voucher-option__amount">¥{{item.amountText}}</view></view></view><view wx:if="{{candidate.refundable}}" class="description-field"><view>申请说明</view><textarea maxlength="500" placeholder="填写退款原因（最多500字）" value="{{description}}" bindinput="onDescription" /><view class="description-count">{{description.length}}/500</view></view><view class="result-actions"><button class="secondary-action" bindtap="resetSearch">重新查询</button><button class="primary-action" loading="{{submitting}}" disabled="{{submitting || !selectedIdsList.length}}" bindtap="submit">提交平台审核</button></view></view>
</view>
<view wx:if="{{helpVisible}}" class="help-mask" catchtap="closeHelp"><view class="help-sheet" catchtap="noop"><view class="help-title">如何查找</view><view>订单编号可在门店订单列表中复制；券码可由顾客提供完整券码。系统只展示券码后四位用于核对。</view><button class="primary-action" bindtap="closeHelp">知道了</button></view></view>
