<view class="profile-page page-enter" style="padding-top: {{statusBarHeight}}px;">
  <view class="profile-scan pressable" data-label="账号二维码" bind:tap="unavailable">
    <t-icon name="scan" size="46rpx" />
  </view>

  <view wx:if="{{loading && !current}}" class="profile-loading">正在同步商户身份...</view>
  <view wx:elif="{{error && !current}}" class="profile-error">
    <text>{{error}}</text>
    <text bind:tap="loadCurrent">重新加载</text>
  </view>

  <view class="profile-hero pressable" bind:tap="openAccountPanel">
    <image wx:if="{{avatarLocalPath}}" class="profile-avatar" src="{{avatarLocalPath}}" mode="aspectFill" />
    <view wx:else class="profile-avatar profile-avatar--fallback">{{avatarText}}</view>
    <view class="profile-name-row">
      <view class="profile-name">{{loggedIn ? displayName : '登录商户账号'}}</view>
      <t-icon name="chevron-right" size="38rpx" color="#64626d" />
    </view>
    <view class="profile-phone">{{loggedIn ? '账号：' + current.maskedPhone : '登录后查看门店与经营状态'}}</view>
    <view wx:if="{{loggedIn}}" class="profile-tags">
      <text>{{current.roleLabel}}</text>
      <text class="profile-tag--accent">{{current.statusLabel}}</text>
    </view>
  </view>

  <view class="profile-menu profile-menu--single pressable" data-label="切换公司" bind:tap="unavailable">
    <view class="profile-menu-icon"><t-icon name="shop" size="42rpx" /></view>
    <view class="profile-menu-label">切换公司</view>
    <view class="profile-menu-value">{{current && current.shop ? current.shop.name : '暂无其他公司'}}</view>
    <t-icon name="chevron-right" size="38rpx" color="#9b99a3" />
  </view>

  <view class="profile-menu profile-menu--group">
    <view class="profile-menu-row pressable" bind:tap="openCustomerService">
      <view class="profile-menu-icon"><t-icon name="edit" size="42rpx" /></view>
      <view class="profile-menu-label">我要反馈</view>
      <t-icon name="chevron-right" size="38rpx" color="#9b99a3" />
    </view>
    <view class="profile-menu-row pressable" data-label="消息设置" bind:tap="unavailable">
      <view class="profile-menu-icon"><t-icon name="setting" size="42rpx" /></view>
      <view class="profile-menu-label">消息设置</view>
      <t-icon name="chevron-right" size="38rpx" color="#9b99a3" />
    </view>
    <view class="profile-menu-row pressable" bind:tap="openPrivacy">
      <view class="profile-menu-icon"><t-icon name="lock-on" size="42rpx" /></view>
      <view class="profile-menu-label">隐私与权限</view>
      <t-icon name="chevron-right" size="38rpx" color="#9b99a3" />
    </view>
    <view class="profile-menu-row pressable" bind:tap="showAbout">
      <view class="profile-menu-icon"><t-icon name="info-circle" size="42rpx" /></view>
      <view class="profile-menu-label">关于 Roamly</view>
      <t-icon name="chevron-right" size="38rpx" color="#9b99a3" />
    </view>
    <view class="profile-menu-row pressable" bind:tap="clearCache">
      <view class="profile-menu-icon"><t-icon name="delete" size="42rpx" /></view>
      <view class="profile-menu-label">清除缓存</view>
      <t-icon name="chevron-right" size="38rpx" color="#9b99a3" />
    </view>
  </view>

  <view wx:if="{{accountPanelVisible}}" class="account-mask" catch:tap="closeAccountPanel">
    <view class="account-panel" catch:tap="noop">
      <view class="account-panel__handle"></view>
      <view class="account-panel__head">
        <view>
          <view class="account-panel__title">账号与门店</view>
          <view class="account-panel__status">{{guidance}}</view>
        </view>
        <view class="account-panel__close" bind:tap="closeAccountPanel">关闭</view>
      </view>
      <view wx:if="{{canOnboard}}" class="account-action pressable" bind:tap="openOnboarding">
        <view><strong>{{onboardingLabel}}</strong><text>查看并处理当前入驻状态</text></view>
        <t-icon name="chevron-right" size="38rpx" />
      </view>
      <view wx:if="{{canAcceptInvitation}}" class="account-action pressable" bind:tap="openStaffAcceptance">
        <view><strong>接受员工邀请</strong><text>通过六位凭证加入公司</text></view>
        <t-icon name="chevron-right" size="38rpx" />
      </view>
      <view class="account-action pressable" bind:tap="openAccount">
        <view><strong>个人信息</strong><text>头像、昵称与账号安全</text></view>
        <t-icon name="chevron-right" size="38rpx" />
      </view>
      <view wx:if="{{current && current.status === 'ACTIVE'}}" class="account-action pressable" bind:tap="openManagement">
        <view><strong>进入管理版</strong><text>订单、团购券、员工和结算</text></view>
        <t-icon name="chevron-right" size="38rpx" />
      </view>
      <button class="account-logout" bind:tap="logout">退出登录</button>
    </view>
  </view>
</view>
