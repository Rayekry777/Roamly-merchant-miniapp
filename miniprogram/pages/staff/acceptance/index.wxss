.accept-panel {
  display: flex;
  width: 100%;
  min-width: 0;
  flex-direction: column;
  gap: 16rpx;
  margin: 24rpx 0;
  padding: 24rpx;
  box-sizing: border-box;
  background: #fff;
  border: 1rpx solid var(--roamly-border);
  border-radius: 20rpx;
}

.accept-panel input {
  width: 100%;
  min-width: 0;
  min-height: 80rpx;
  padding: 24rpx;
  box-sizing: border-box;
  background: var(--roamly-bg);
  border-radius: 12rpx;
}

.accept-panel button {
  width: 100%;
  min-width: 0;
  min-height: 84rpx;
  margin: 0;
  line-height: 84rpx;
}

.onboarding-note {
  margin-top: 20rpx;
  color: var(--roamly-muted);
  font-size: 24rpx;
  line-height: 1.6;
}
