<app-navbar title="接受员工邀请" />
<view class="page-shell page-shell--subpage page-enter"><view class="page-heading">接受员工邀请</view><view class="page-rule" aria-hidden="true"></view><view class="accept-panel"><input type="number" maxlength="6" placeholder="输入六位数字邀请凭证" value="{{credentialCode}}" bindinput="onCredentialCode"/><button class="primary-action" loading="{{loading}}" bindtap="accept">确认加入公司</button></view><view wx:if="{{error}}" class="error-panel">{{error}}</view><view class="onboarding-note">请使用受邀手机号登录。凭证生成后 60 秒内有效，且只能接受一次。</view></view>
<success-motion id="success-motion" message="已加入门店" />
