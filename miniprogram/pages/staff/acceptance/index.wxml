<view class="page-shell"><view class="page-kicker">ROAMLY MERCHANT</view><view class="page-heading">接受员工邀请</view><view class="page-rule" aria-hidden="true"></view><view class="accept-panel"><input maxlength="128" placeholder="输入邀请码" value="{{token}}" bindinput="onToken"/><button bindtap="scan">扫描邀请二维码</button><button class="primary-action" loading="{{loading}}" bindtap="accept">确认加入门店</button></view><view wx:if="{{error}}" class="error-panel">{{error}}</view><view class="onboarding-note">请先使用受邀手机号登录，邀请仅可接受一次且 24 小时内有效。</view></view>
