.invite-panel {
  display: grid;
  width: 100%;
  min-width: 0;
  max-width: 100%;
  gap: 16rpx;
  margin: 24rpx 0;
  padding: 24rpx;
  box-sizing: border-box;
  background: #fff;
  border: 1rpx solid var(--roamly-border);
  border-radius: 20rpx;
}

.invite-panel input,
.picker {
  display: block;
  width: 100%;
  min-width: 0;
  max-width: 100%;
  height: 80rpx;
  padding: 0 22rpx;
  box-sizing: border-box;
  background: var(--roamly-bg);
  border-radius: 12rpx;
}

.invite-panel picker {
  display: block;
  width: 100%;
  min-width: 0;
  max-width: 100%;
}

.invite-panel input {
  line-height: 80rpx;
  color: var(--roamly-text);
  font-size: 24rpx;
}

.picker {
  line-height: 80rpx;
  color: var(--roamly-text);
  font-size: 24rpx;
}

.invite-panel .primary-action {
  display: flex;
  width: 100%;
  min-width: 0;
  max-width: 100%;
  height: 80rpx;
  margin: 0;
  padding: 0;
  box-sizing: border-box;
  align-items: center;
  justify-content: center;
  line-height: 1;
}

.invite-hint {
  color: var(--roamly-muted);
  font-size: 22rpx;
  line-height: 1.55;
}

.section-block {
  width: 100%;
  min-width: 0;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.credential-card {
  width: 100%;
  box-sizing: border-box;
  margin-bottom: 24rpx;
  padding: 32rpx 24rpx;
  border-radius: 20rpx;
  background: #fff;
  border: 1rpx solid var(--roamly-border);
  text-align: center;
}

.credential-card__label {
  color: var(--roamly-muted);
  font-size: 24rpx;
}

.credential-code {
  margin-top: 18rpx;
  color: var(--roamly-primary);
  font-size: 62rpx;
  font-weight: 760;
  letter-spacing: 18rpx;
  line-height: 1.2;
  text-indent: 18rpx;
}

.credential-code--expired {
  color: var(--roamly-muted);
}

.credential-status {
  margin-top: 12rpx;
  color: var(--roamly-muted);
  font-size: 23rpx;
}

.credential-actions {
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
  gap: 16rpx;
  margin-top: 24rpx;
}

.credential-actions button {
  width: 100%;
  min-width: 0;
  margin: 0;
}

.credential-revoke {
  color: #c84c48;
}
