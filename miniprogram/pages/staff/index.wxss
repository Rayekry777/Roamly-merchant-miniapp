.invite-panel {
  display: grid;
  width: 100%;
  min-width: 0;
  max-width: 100%;
  gap: 16rpx;
  margin: 24rpx 0;
  padding: 24rpx;
  box-sizing: border-box;
  background: #fff;
  border: 1rpx solid var(--roamly-border);
  border-radius: 20rpx;
}

.invite-panel input,
.picker {
  display: block;
  width: 100%;
  min-width: 0;
  max-width: 100%;
  height: 80rpx;
  padding: 0 22rpx;
  box-sizing: border-box;
  background: var(--roamly-bg);
  border-radius: 12rpx;
}

.invite-panel picker {
  display: block;
  width: 100%;
  min-width: 0;
  max-width: 100%;
}

.invite-panel input {
  line-height: 80rpx;
  color: var(--roamly-text);
  font-size: 24rpx;
}

.picker {
  line-height: 80rpx;
  color: var(--roamly-text);
  font-size: 24rpx;
}

.invite-panel .primary-action {
  display: flex;
  width: 100%;
  min-width: 0;
  max-width: 100%;
  height: 80rpx;
  margin: 0;
  padding: 0;
  box-sizing: border-box;
  align-items: center;
  justify-content: center;
  line-height: 1;
}

.section-block {
  width: 100%;
  min-width: 0;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.qr-mask {
  position: fixed;
  inset: 0;
  z-index: 20;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
  background: rgb(36 35 49 / 52%);
}

.qr-dialog {
  width: 100%;
  max-width: 620rpx;
  box-sizing: border-box;
  padding: 32rpx;
  border-radius: 20rpx;
  background: #fff;
  text-align: center;
}

.qr-dialog__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 32rpx;
  font-weight: 700;
}

.qr-close {
  color: var(--roamly-muted);
  font-size: 24rpx;
  font-weight: 400;
}

.qr-dialog t-qrcode {
  display: block;
  width: 288px;
  height: 288px;
  margin: 32rpx auto 20rpx;
}

.qr-token {
  overflow-wrap: anywhere;
  color: var(--roamly-primary);
  font-size: 24rpx;
}

.qr-tip {
  margin-top: 18rpx;
  color: var(--roamly-muted);
  font-size: 23rpx;
}
