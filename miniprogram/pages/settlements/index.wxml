<app-navbar title="结算记录" />

<view class="page-shell page-shell--subpage settlement-page page-enter">
  <view class="page-heading">结算记录</view>
  <view class="page-copy">结算数据以服务端批次结果为准</view>

  <view wx:if="{{loading && !items.length}}" class="state-panel">正在加载结算记录...</view>
  <view wx:elif="{{error && !items.length}}" class="error-panel">
    <view>{{error}}</view>
    <button class="text-action" bind:tap="retry">重新加载</button>
  </view>
  <view wx:elif="{{!items.length}}" class="state-panel">暂无结算记录</view>

  <view wx:else class="settlement-list">
    <view wx:for="{{items}}" wx:key="id" class="settlement-card surface-card pressable" data-id="{{item.id}}" bind:tap="openDetail">
      <view class="settlement-head">
        <view>
          <view class="settlement-date">{{item.settlementDateText}}</view>
          <view class="settlement-id">批次 {{item.maskedId}}</view>
        </view>
        <view class="settlement-status status-{{item.statusTone}}">{{item.statusText}}</view>
      </view>
      <view class="settlement-amount"><text>结算金额</text><strong>¥{{item.totalAmountText}}</strong></view>
      <view class="settlement-foot"><text>{{item.processedTimeText}}</text><t-icon name="chevron-right" size="38rpx" color="#9b99a3" /></view>
    </view>
    <view wx:if="{{loading}}" class="list-footer">正在加载更多...</view>
    <view wx:elif="{{error}}" class="list-footer list-error" bind:tap="retry">{{error}}，点击重试</view>
    <view wx:elif="{{!hasMore}}" class="list-footer">没有更多结算记录了</view>
  </view>
</view>
