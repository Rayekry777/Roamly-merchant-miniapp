.messages-page {
  min-height: 100vh;
  padding-right: 32rpx;
  padding-bottom: calc(148rpx + env(safe-area-inset-bottom));
  padding-left: 32rpx;
  box-sizing: border-box;
  background:
    radial-gradient(circle at 16% 2%, rgba(255, 95, 87, 0.16), transparent 34%),
    radial-gradient(
      circle at 90% 12%,
      rgba(130, 117, 255, 0.17),
      transparent 31%
    ),
    #f4f5fb;
}

.messages-head {
  display: flex;
  height: 116rpx;
  align-items: center;
  justify-content: space-between;
}

.messages-title {
  color: var(--roamly-text);
  font-size: 44rpx;
  font-weight: 760;
}

.messages-setting {
  display: flex;
  width: 68rpx;
  height: 68rpx;
  align-items: center;
  justify-content: center;
  border-radius: 24rpx;
  color: var(--roamly-muted);
  background: rgba(255, 255, 255, 0.72);
}

.empty-message {
  display: flex;
  min-height: 600rpx;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: var(--roamly-muted);
  text-align: center;
}

.empty-message__icon {
  display: flex;
  width: 148rpx;
  height: 148rpx;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  color: var(--roamly-accent);
  background: rgba(130, 117, 255, 0.11);
}

.empty-message__title {
  margin-top: 34rpx;
  color: var(--roamly-text);
  font-size: 32rpx;
  font-weight: 700;
}

.empty-message__copy {
  margin-top: 12rpx;
  font-size: 24rpx;
}
