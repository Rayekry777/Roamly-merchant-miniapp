.messages-page {
  min-height: 100vh;
  padding-right: 32rpx;
  padding-bottom: calc(148rpx + env(safe-area-inset-bottom));
  padding-left: 32rpx;
  box-sizing: border-box;
  background:
    radial-gradient(circle at 16% 2%, rgba(255, 95, 87, 0.16), transparent 34%),
    radial-gradient(
      circle at 90% 12%,
      rgba(130, 117, 255, 0.17),
      transparent 31%
    ),
    #f4f5fb;
}

.messages-head {
  display: flex;
  height: 116rpx;
  align-items: center;
  justify-content: space-between;
}

.messages-head > view {
  display: grid;
  gap: 5rpx;
}

.messages-head button {
  padding: 0 24rpx;
  color: #fff;
  background: var(--roamly-primary);
  border-radius: 30rpx;
  font-size: 23rpx;
  line-height: 62rpx;
}

.messages-title {
  color: var(--roamly-text);
  font-size: 44rpx;
  font-weight: 760;
}

.messages-subtitle {
  color: var(--roamly-muted);
  font-size: 21rpx;
}

.ticket-list {
  display: grid;
  padding: 20rpx 24rpx 140rpx;
  gap: 18rpx;
}

.ticket-card {
  padding: 26rpx;
  background: #fff;
  border: 1rpx solid var(--roamly-border);
  border-radius: 24rpx;
  box-shadow: 0 10rpx 30rpx rgb(45 42 80 / 6%);
}

.ticket-card__head {
  display: flex;
  justify-content: space-between;
  gap: 18rpx;
}

.ticket-card__head strong {
  overflow: hidden;
  font-size: 28rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.ticket-card__head text,
.ticket-card__unread,
.retry {
  color: var(--roamly-primary);
  font-size: 22rpx;
}

.ticket-card__meta,
.ticket-card__copy {
  margin-top: 10rpx;
  overflow: hidden;
  color: var(--roamly-muted);
  font-size: 22rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.ticket-card__unread {
  margin-top: 12rpx;
  font-weight: 700;
}

.message-state {
  display: grid;
  min-height: 500rpx;
  color: var(--roamly-muted);
  place-items: center;
}

.messages-setting {
  display: flex;
  width: 68rpx;
  height: 68rpx;
  align-items: center;
  justify-content: center;
  border-radius: 24rpx;
  color: var(--roamly-muted);
  background: rgba(255, 255, 255, 0.72);
}

.empty-message {
  display: flex;
  min-height: 600rpx;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: var(--roamly-muted);
  text-align: center;
}

.empty-message__icon {
  display: flex;
  width: 148rpx;
  height: 148rpx;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  color: var(--roamly-accent);
  background: rgba(130, 117, 255, 0.11);
}

.empty-message__title {
  margin-top: 34rpx;
  color: var(--roamly-text);
  font-size: 32rpx;
  font-weight: 700;
}

.empty-message__copy {
  margin-top: 12rpx;
  font-size: 24rpx;
}
