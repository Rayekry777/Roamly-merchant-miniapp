.preview-page {
  min-height: 100vh;
  padding-bottom: calc(142rpx + env(safe-area-inset-bottom));
  background: var(--roamly-bg);
}

.state-panel {
  padding-top: 160rpx;
  color: var(--roamly-muted);
  font-size: 25rpx;
  text-align: center;
}

.error-panel {
  color: #c84c48;
}

.hero-media {
  position: relative;
  width: 100%;
  height: 430rpx;
  overflow: hidden;
  background: #f0edff;
}

.hero-media image,
.cover-placeholder {
  width: 100%;
  height: 100%;
}

.cover-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #6c59d9;
  font-size: 38rpx;
  font-weight: 800;
}

.preview-flag {
  position: absolute;
  top: 26rpx;
  right: 26rpx;
  padding: 10rpx 16rpx;
  border-radius: 18rpx;
  color: #ffffff;
  background: rgba(36, 35, 49, 0.72);
  font-size: 20rpx;
  font-weight: 700;
}

.preview-content {
  min-height: auto;
  padding-top: 28rpx;
}

.title-meta,
.price-row,
.shop-band,
.summary-row,
.package-row,
.package-right,
.footer-actions {
  display: flex;
  align-items: center;
}

.title-meta {
  gap: 10rpx;
}

.title-meta text {
  padding: 7rpx 12rpx;
  border-radius: 16rpx;
  color: #6c59d9;
  background: #f0edff;
  font-size: 20rpx;
  font-weight: 700;
}

.title-meta text:last-child {
  color: #65636d;
  background: #eeeef3;
}

.voucher-title {
  margin-top: 17rpx;
  color: var(--roamly-text);
  font-size: 38rpx;
  font-weight: 800;
  line-height: 1.35;
  overflow-wrap: anywhere;
}

.price-row {
  gap: 14rpx;
  margin-top: 14rpx;
}

.price-now {
  color: var(--roamly-primary);
  font-size: 38rpx;
  font-weight: 800;
}

.price-market {
  color: var(--roamly-muted);
  font-size: 23rpx;
  text-decoration: line-through;
}

.error-banner,
.shop-band,
.content-section {
  margin-top: 24rpx;
  border: 1rpx solid var(--roamly-border);
  border-radius: var(--roamly-card-radius);
  background: var(--roamly-surface);
}

.error-banner {
  padding: 24rpx;
  color: #c84c48;
  font-size: 23rpx;
  line-height: 1.6;
}

.text-action {
  width: auto;
  margin: 10rpx 0 0;
  padding: 0;
  color: var(--roamly-primary);
  background: transparent;
  font-size: 22rpx;
}

.text-action::after,
.primary-action::after,
.secondary-action::after {
  border: 0;
}

.shop-band {
  gap: 18rpx;
  padding: 25rpx;
}

.shop-mark {
  display: flex;
  width: 66rpx;
  height: 66rpx;
  flex: none;
  align-items: center;
  justify-content: center;
  border-radius: 22rpx;
  color: #ffffff;
  background: var(--roamly-accent);
  font-size: 27rpx;
  font-weight: 800;
}

.shop-copy {
  min-width: 0;
}

.shop-copy view:first-child {
  color: var(--roamly-text);
  font-size: 27rpx;
  font-weight: 750;
}

.shop-copy view:last-child {
  margin-top: 6rpx;
  overflow: hidden;
  color: var(--roamly-muted);
  font-size: 21rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.content-section {
  padding: 28rpx;
}

.section-title {
  margin-bottom: 12rpx;
  color: var(--roamly-text);
  font-size: 29rpx;
  font-weight: 750;
}

.summary-row,
.package-row {
  min-width: 0;
  justify-content: space-between;
  gap: 24rpx;
  padding: 17rpx 0;
  border-bottom: 1rpx solid var(--roamly-border);
  font-size: 23rpx;
  line-height: 1.5;
}

.summary-row:last-child,
.package-row:last-child {
  border-bottom: 0;
}

.summary-row > text:first-child {
  flex: none;
  color: var(--roamly-muted);
}

.summary-row > text:last-child {
  min-width: 0;
  color: var(--roamly-text);
  text-align: right;
  overflow-wrap: anywhere;
}

.multiline {
  align-items: flex-start;
}

.package-name {
  min-width: 0;
  flex: 1;
  color: var(--roamly-text);
  overflow-wrap: anywhere;
}

.package-right {
  flex: none;
  gap: 14rpx;
  color: var(--roamly-muted);
}

.package-right text:last-child {
  color: var(--roamly-text);
}

.rule-line {
  padding: 15rpx 0;
  border-bottom: 1rpx solid var(--roamly-border);
  color: var(--roamly-text);
  font-size: 23rpx;
  line-height: 1.55;
}

.rule-line:last-child {
  border-bottom: 0;
}

.rule-line text:last-child:not(:first-child) {
  display: block;
  margin-top: 5rpx;
  color: var(--roamly-muted);
  font-size: 21rpx;
}

.detail-section {
  padding-bottom: 14rpx;
}

.detail-media {
  width: 100%;
  margin-top: 14rpx;
  overflow: hidden;
  border-radius: 26rpx;
  background: var(--roamly-bg);
}

.detail-media image {
  display: block;
  width: 100%;
}

.media-unavailable {
  display: flex;
  min-height: 220rpx;
  align-items: center;
  justify-content: center;
  color: var(--roamly-muted);
  font-size: 22rpx;
}

.footer-actions {
  position: fixed;
  z-index: 10;
  right: 0;
  bottom: 0;
  left: 0;
  gap: 14rpx;
  padding: 18rpx 26rpx calc(18rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid var(--roamly-border);
  background: rgba(255, 255, 255, 0.97);
}

.primary-action,
.secondary-action {
  min-width: 0;
  height: 84rpx;
  flex: 1;
  margin: 0;
  border-radius: var(--roamly-control-radius);
  font-size: 25rpx;
  font-weight: 700;
  line-height: 84rpx;
}

.primary-action {
  color: #ffffff;
  background: var(--roamly-primary);
}

.secondary-action {
  border: 1rpx solid var(--roamly-border);
  color: var(--roamly-text);
  background: var(--roamly-surface);
}

.disabled-action {
  color: var(--roamly-muted);
  background: #e8e8ee;
}
