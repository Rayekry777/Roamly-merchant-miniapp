.voucher-list-page {
  padding-bottom: calc(56rpx + env(safe-area-inset-bottom));
}

.heading-row,
.filter-row,
.voucher-main,
.voucher-meta,
.row-actions,
.search-field {
  display: flex;
  align-items: center;
}

.heading-row {
  justify-content: space-between;
  gap: 24rpx;
}

.heading-copy {
  margin-top: 8rpx;
  color: var(--roamly-muted);
  font-size: 23rpx;
}

.create-button,
.empty-action {
  margin: 0;
  border-radius: var(--roamly-control-radius);
  color: #ffffff;
  background: var(--roamly-primary);
  font-size: 24rpx;
  font-weight: 700;
}

.create-button {
  width: 132rpx;
  height: 72rpx;
  line-height: 72rpx;
}

.create-button::after,
.empty-action::after,
.retry-action::after,
.search-field button::after,
.row-actions button::after {
  border: 0;
}

.review-tabs {
  width: 100%;
  margin-top: 30rpx;
  white-space: nowrap;
}

.review-tabs-inner {
  display: inline-flex;
  gap: 12rpx;
  padding-right: 24rpx;
}

.review-tab {
  padding: 16rpx 25rpx;
  border: 1rpx solid var(--roamly-border);
  border-radius: 28rpx;
  color: var(--roamly-muted);
  background: var(--roamly-surface);
  font-size: 23rpx;
}

.review-tab-active {
  border-color: var(--roamly-primary);
  color: var(--roamly-primary);
  background: #fff6f5;
  font-weight: 700;
}

.filter-row {
  gap: 14rpx;
  margin-top: 24rpx;
}

.search-field {
  min-width: 0;
  height: 76rpx;
  flex: 1;
  padding-left: 24rpx;
  border: 1rpx solid var(--roamly-border);
  border-radius: var(--roamly-control-radius);
  background: var(--roamly-surface);
}

.search-field input {
  min-width: 0;
  flex: 1;
  color: var(--roamly-text);
  font-size: 24rpx;
}

.search-field button {
  width: 100rpx;
  height: 72rpx;
  margin: 0;
  color: var(--roamly-primary);
  background: transparent;
  font-size: 23rpx;
  line-height: 72rpx;
}

.type-picker {
  height: 76rpx;
  padding: 0 22rpx;
  border: 1rpx solid var(--roamly-border);
  border-radius: var(--roamly-control-radius);
  color: var(--roamly-text);
  background: var(--roamly-surface);
  font-size: 23rpx;
  line-height: 76rpx;
}

.state-panel {
  margin-top: 30rpx;
  padding: 54rpx 28rpx;
  border: 1rpx solid var(--roamly-border);
  border-radius: var(--roamly-card-radius);
  color: var(--roamly-muted);
  background: var(--roamly-surface);
  font-size: 25rpx;
  text-align: center;
}

.error-panel {
  color: #c84c48;
}

.retry-action {
  width: auto;
  margin-top: 18rpx;
  color: var(--roamly-primary);
  background: transparent;
  font-size: 23rpx;
}

.empty-mark {
  display: flex;
  width: 82rpx;
  height: 82rpx;
  align-items: center;
  justify-content: center;
  margin: 0 auto;
  border-radius: 28rpx;
  color: var(--roamly-accent);
  background: #f0edff;
  font-size: 31rpx;
  font-weight: 800;
}

.empty-title {
  margin-top: 24rpx;
  color: var(--roamly-text);
  font-size: 28rpx;
  font-weight: 700;
}

.empty-copy {
  margin-top: 10rpx;
  line-height: 1.6;
}

.empty-action {
  width: 240rpx;
  margin: 28rpx auto 0;
}

.voucher-list {
  margin-top: 28rpx;
}

.voucher-row {
  margin-top: 20rpx;
  overflow: hidden;
  border: 1rpx solid var(--roamly-border);
  border-radius: var(--roamly-card-radius);
  background: var(--roamly-surface);
  box-shadow: var(--roamly-shadow);
}

.voucher-main {
  min-width: 0;
  align-items: flex-start;
  padding: 26rpx;
}

.voucher-cover {
  width: 176rpx;
  height: 144rpx;
  flex: 0 0 176rpx;
  overflow: hidden;
  border-radius: 28rpx;
  background: var(--roamly-bg);
}

.voucher-cover image,
.cover-placeholder {
  width: 100%;
  height: 100%;
}

.cover-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--roamly-accent);
  background: #f0edff;
  font-size: 42rpx;
  font-weight: 800;
}

.voucher-copy {
  min-width: 0;
  flex: 1;
  margin-left: 22rpx;
}

.voucher-meta {
  gap: 10rpx;
}

.type-label,
.status-label {
  padding: 6rpx 12rpx;
  border-radius: 16rpx;
  font-size: 20rpx;
  font-weight: 700;
}

.type-label {
  color: #6c59d9;
  background: #f0edff;
}

.status-label {
  color: #65636d;
  background: #f0f0f4;
}

.status-active {
  color: #13795b;
  background: #e7f7f0;
}

.status-pending {
  color: #6c59d9;
  background: #f0edff;
}

.status-warning {
  color: #b14d39;
  background: #fff0ec;
}

.voucher-title {
  margin-top: 13rpx;
  overflow: hidden;
  color: var(--roamly-text);
  font-size: 28rpx;
  font-weight: 750;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.voucher-price {
  margin-top: 9rpx;
  color: var(--roamly-primary);
  font-size: 28rpx;
  font-weight: 800;
}

.voucher-note {
  margin-top: 8rpx;
  overflow: hidden;
  color: var(--roamly-muted);
  font-size: 21rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.reject-reason {
  margin: 0 26rpx;
  padding: 18rpx 20rpx;
  border-radius: 22rpx;
  color: #a7473a;
  background: #fff6f4;
  font-size: 22rpx;
  line-height: 1.5;
}

.row-actions {
  justify-content: flex-end;
  gap: 10rpx;
  padding: 18rpx 22rpx;
  border-top: 1rpx solid var(--roamly-border);
}

.row-actions button {
  width: auto;
  min-width: 104rpx;
  height: 58rpx;
  margin: 0;
  padding: 0 20rpx;
  border: 1rpx solid var(--roamly-border);
  border-radius: 24rpx;
  color: var(--roamly-text);
  background: var(--roamly-surface);
  font-size: 22rpx;
  line-height: 56rpx;
}

.row-actions .danger-action {
  color: #c84c48;
}
