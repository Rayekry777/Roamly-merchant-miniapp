<view class="login-page">
  <view class="login-header">
    <view class="brand-mark">R</view>
    <view class="brand-name">Roamly 商户</view>
    <view class="brand-copy">登录后查看门店状态与经营入口</view>
  </view>

  <view class="login-surface">
    <view class="field-label">手机号</view>
    <input class="field-input" type="number" maxlength="11" value="{{phone}}" placeholder="请输入商户手机号" bindinput="onPhone" />
    <view class="field-label field-label-spaced">验证码</view>
    <view class="code-row">
      <input class="field-input code-input" type="number" maxlength="6" value="{{code}}" placeholder="六位验证码" bindinput="onCode" />
      <button class="code-button" disabled="{{sending || countdown > 0}}" bindtap="sendCode">
        {{countdown > 0 ? countdown + 's' : sending ? '发送中' : '获取验证码'}}
      </button>
    </view>
    <view wx:if="{{error}}" class="form-error">{{error}}</view>
    <button class="primary-button" loading="{{loggingIn}}" disabled="{{loggingIn}}" bindtap="submit">登录商户端</button>
  </view>

  <view class="login-foot">开发环境验证码由服务端 Mock 策略提供</view>
</view>
