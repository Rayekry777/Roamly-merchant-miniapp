.login-page {
  position: relative;
  width: 100%;
  min-height: 100vh;
  overflow: hidden;
  background: linear-gradient(150deg, #f9faff, #e9e9fb);
}

.login-panel {
  position: relative;
  z-index: 2;
  margin: 46rpx 34rpx 0;
  padding: 46rpx 42rpx 40rpx;
  border: 1rpx solid var(--roamly-border);
  border-radius: var(--roamly-card-radius);
  background: rgba(255, 255, 255, 0.94);
  box-shadow: var(--roamly-shadow);
}

.brand-logo {
  display: block;
  width: 88rpx;
  height: 88rpx;
  margin-bottom: 20rpx;
}

.mode-title {
  margin-bottom: 28rpx;
  color: var(--roamly-text);
  font-size: 36rpx;
  font-weight: 750;
}

.fields {
  overflow: hidden;
  margin: 0 0 28rpx;
  padding: 10rpx 18rpx;
  border-radius: 32rpx;
  background: rgba(255, 255, 255, 0.82);
}

.field-line {
  height: 1rpx;
  background: var(--roamly-border);
}

.code-row {
  display: flex;
  min-width: 0;
  align-items: center;
  gap: 8rpx;
}

.code-input {
  width: 0;
  min-width: 0;
  flex: 1;
}

.code-button {
  min-width: 178rpx;
  flex: 0 0 178rpx;
  white-space: nowrap;
}

.form-error {
  margin: -10rpx 8rpx 24rpx;
  color: var(--roamly-danger);
  font-size: 23rpx;
  line-height: 1.5;
}

.mode-actions {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 30rpx;
  padding: 0 10rpx;
}

.mode-actions--center {
  justify-content: center;
}

.mode-link {
  color: var(--roamly-accent);
  font-size: 25rpx;
}

.login-foot {
  position: absolute;
  right: 0;
  bottom: calc(30rpx + env(safe-area-inset-bottom));
  left: 0;
  z-index: 2;
  color: #aaa8b5;
  font-size: 20rpx;
  text-align: center;
}

.orb {
  position: absolute;
  width: 500rpx;
  height: 500rpx;
  border-radius: 50%;
  opacity: 0.5;
}

.orb--one {
  top: -220rpx;
  right: -160rpx;
  background: #ffd9d5;
}

.orb--two {
  bottom: -260rpx;
  left: -180rpx;
  background: #dcd7ff;
}
