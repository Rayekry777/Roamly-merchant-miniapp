.account-page {
  min-height: 100vh;
  padding: 28rpx 28rpx 80rpx;
  box-sizing: border-box;
  background: var(--roamly-bg);
}

.account-card {
  overflow: hidden;
  padding: 0 28rpx;
  border: 1rpx solid var(--roamly-border);
  border-radius: 28rpx;
  background: var(--roamly-surface);
  box-shadow: var(--roamly-shadow-soft);

  --td-input-bg-color: transparent;
}

.account-card--readonly {
  margin-top: 24rpx;
  padding-bottom: 18rpx;
}

.section-title {
  padding-top: 26rpx;
  color: var(--roamly-muted);
  font-size: 23rpx;
}

.account-row {
  display: flex;
  min-height: 104rpx;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.label {
  flex: none;
  font-size: 28rpx;
  font-weight: 650;
}

.row-value {
  display: flex;
  min-width: 0;
  align-items: center;
  gap: 16rpx;
  color: var(--roamly-muted);
  font-size: 25rpx;
}

.row-value--shop {
  max-width: 430rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.avatar {
  width: 86rpx;
  height: 86rpx;
  overflow: hidden;
  border-radius: 50%;
}

.avatar--fallback {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  background: linear-gradient(
    145deg,
    var(--roamly-primary),
    var(--roamly-accent)
  );
  font-size: 32rpx;
  font-weight: 750;
}

.divider {
  height: 1rpx;
  background: var(--roamly-border);
}

.nickname-block {
  padding-bottom: 18rpx;
}

.nickname-input {
  width: 430rpx;
  text-align: right;
}

.nickname-meta {
  display: flex;
  justify-content: flex-end;
  gap: 20rpx;
  color: var(--roamly-muted);
  font-size: 21rpx;
}

.action {
  color: var(--roamly-primary);
}

.logout-button {
  margin-top: 34rpx;
}

.shop-address {
  margin: -16rpx 0 12rpx 150rpx;
  color: var(--roamly-muted);
  font-size: 22rpx;
  line-height: 1.5;
  text-align: right;
}

@media (width <= 340px) {
  .nickname-input {
    width: 350rpx;
  }
}
