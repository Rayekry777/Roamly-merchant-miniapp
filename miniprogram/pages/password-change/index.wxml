<app-navbar title="修改密码" />
<view class="security-page page-enter">
  <view class="security-card roamly-panel">
    <view class="phone-tip">验证码将发送至 {{phone}}</view>
    <view class="code-row">
      <t-input class="code-input" type="number" maxlength="6" placeholder="当前手机号验证码" bind:change="onValue" data-field="code" />
      <t-button class="code-button" variant="text" loading="{{codeLoading}}" disabled="{{countdown > 0 || codeLoading}}" bind:tap="getCode">{{countdown ? countdown + 's' : '获取验证码'}}</t-button>
    </view>
    <view class="divider"></view>
    <t-input type="password" placeholder="旧密码" bind:change="onValue" data-field="currentPassword" />
    <view class="divider"></view>
    <t-input type="password" maxlength="64" placeholder="新密码（8–64位，含字母和数字）" bind:change="onValue" data-field="newPassword" />
    <view class="divider"></view>
    <t-input type="password" maxlength="64" placeholder="确认新密码" bind:change="onValue" data-field="confirmPassword" />
  </view>
  <t-button theme="primary" shape="round" block size="large" loading="{{loading}}" bind:tap="submit">确认修改</t-button>
  <view class="tip">修改成功后，该商户账号的全部登录会话都会失效</view>
</view>
