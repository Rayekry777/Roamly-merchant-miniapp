.security-page {
  min-height: 100vh;
  padding: 28rpx;
  box-sizing: border-box;
  background: var(--roamly-bg);
}

.security-card {
  overflow: hidden;
  margin-bottom: 30rpx;
  padding: 10rpx 20rpx;
  border: 1rpx solid var(--roamly-border);
  border-radius: 28rpx;
  background: var(--roamly-surface);
  box-shadow: var(--roamly-shadow-soft);

  --td-input-bg-color: transparent;
}

.phone-tip {
  padding: 24rpx 16rpx 6rpx;
  color: var(--roamly-muted);
  font-size: 23rpx;
}

.divider {
  height: 1rpx;
  background: var(--roamly-border);
}

.code-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
  background: var(--roamly-surface);
}

.code-input {
  min-width: 0;
  flex: 1;
}

.code-button {
  width: 180rpx;
  flex: none;
}

.tip {
  margin-top: 28rpx;
  color: var(--roamly-muted);
  font-size: 22rpx;
  line-height: 1.5;
  text-align: center;
}
