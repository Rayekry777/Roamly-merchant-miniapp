<app-navbar title="换绑手机号" />
<view class="security-page page-enter">
  <view class="security-card roamly-panel">
    <t-input type="password" placeholder="当前密码" bind:change="onValue" data-field="currentPassword" />
    <view class="divider"></view>
    <t-input type="number" maxlength="11" placeholder="新手机号" bind:change="onValue" data-field="newPhone" />
    <view class="divider"></view>
    <view class="code-row">
      <t-input class="code-input" type="number" maxlength="6" placeholder="新手机号验证码" bind:change="onValue" data-field="code" />
      <t-button class="code-button" variant="text" loading="{{codeLoading}}" disabled="{{countdown > 0 || codeLoading}}" bind:tap="getCode">{{countdown ? countdown + 's' : '获取验证码'}}</t-button>
    </view>
  </view>
  <t-button theme="primary" shape="round" block size="large" loading="{{loading}}" bind:tap="submit">确认换绑</t-button>
  <view class="tip">换绑成功后，该商户账号的全部登录会话都会失效</view>
</view>
