.redemption-page {
  padding-top: 20rpx;
}

.page-copy {
  margin-top: 12rpx;
  color: var(--roamly-muted);
  font-size: 24rpx;
}

.record-list {
  margin-top: 22rpx;
}

.record-card {
  padding: 30rpx;
}

.record-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
}

.record-kicker {
  color: var(--roamly-muted);
  font-size: 21rpx;
}

.record-title {
  margin-top: 8rpx;
  font-size: 31rpx;
  font-weight: 740;
}

.record-status {
  padding: 8rpx 14rpx;
  border-radius: 18rpx;
  font-size: 21rpx;
  font-weight: 680;
}

.record-status--success {
  color: #13795b;
  background: #e7f7f0;
}

.record-status--muted {
  color: #65636d;
  background: #f0f0f4;
}

.record-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 18rpx;
  margin-top: 26rpx;
}

.record-grid view {
  min-width: 0;
  padding: 18rpx;
  border-radius: 22rpx;
  background: var(--roamly-bg);
}

.record-grid text {
  display: block;
  color: var(--roamly-muted);
  font-size: 20rpx;
}

.record-grid strong {
  display: block;
  margin-top: 7rpx;
  overflow: hidden;
  font-size: 24rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.reversal-copy {
  margin-top: 20rpx;
  padding: 18rpx;
  border-radius: 20rpx;
  color: var(--roamly-muted);
  background: #fafaff;
  font-size: 22rpx;
  line-height: 1.5;
}

.reverse-action {
  margin: 24rpx 0 0;
  border: 1rpx solid rgba(216, 77, 73, 0.24);
  border-radius: 26rpx;
  color: var(--roamly-danger);
  background: #fff7f6;
  font-size: 24rpx;
}

.list-error {
  color: var(--roamly-danger);
}

@media (width <= 340px) {
  .record-grid {
    grid-template-columns: 1fr;
  }
}
