<app-navbar title="核销详情"/><view class="detail-page page-shell page-shell--subpage"><view wx:if="{{loading}}" class="state-panel">正在加载...</view><view wx:elif="{{error}}" class="error-panel">{{error}}</view><block wx:elif="{{item}}"><view class="status-title">{{item.status === 'REVERSED' ? '核销已撤销' : '已核销'}}</view><view class="product-card surface-card"><view class="product-title">{{item.productTitle || '--'}}</view><view class="price">¥{{item.incomeText.paid || '--'}}</view></view><view class="info-card surface-card"><view class="section-title">核销明细</view><view class="info-row"><text>核销券码</text><text>{{item.voucherCode || item.voucherId}}</text></view><view class="info-row"><text>核销时间</text><text>{{item.redeemedTimeText}}</text></view><view class="info-row"><text>核销门店</text><text>{{item.shopName || '--'}}</text></view><view class="info-row"><text>核销人</text><text>{{item.operatorName || '--'}}</text></view><view class="info-row"><text>核销方式</text><text>{{item.redemptionMethod || '--'}}</text></view><view class="info-row"><text>商家备注</text><text class="link" bind:tap="editNote">{{item.merchantNote || '添加备注 ✎'}}</text></view></view><view class="info-card surface-card"><view class="section-title">收入明细</view><view class="info-row"><text>商品售价</text><text>¥{{item.incomeText.sale}}</text></view><view class="info-row"><text>商家补贴</text><text>- ¥{{item.incomeText.subsidy}}</text></view><view class="info-row"><text>平台优惠</text><text>- ¥{{item.incomeText.discount}}</text></view><view class="info-row"><text>顾客实付</text><text>¥{{item.incomeText.paid}}</text></view><view class="info-row"><text>软件服务费</text><text>- ¥{{item.incomeText.fee}}</text></view><view class="info-row total"><text>预计收入</text><text>¥{{item.incomeText.income}}</text></view></view></block></view>
