.home-page {
  min-height: 100vh;
  padding-right: 32rpx;
  padding-bottom: calc(168rpx + env(safe-area-inset-bottom));
  padding-left: 32rpx;
  box-sizing: border-box;
  background:
    radial-gradient(circle at 18% 2%, rgba(255, 95, 87, 0.2), transparent 34%),
    radial-gradient(
      circle at 90% 13%,
      rgba(130, 117, 255, 0.2),
      transparent 34%
    ),
    linear-gradient(180deg, #fff5f4 0, #f4f2ff 38%, #f4f5fb 100%);
}

.mode-bar {
  position: sticky;
  top: 0;
  z-index: 30;
  display: flex;
  height: 112rpx;
  align-items: center;
  justify-content: space-between;
  margin: 0 -32rpx;
  padding: 0 32rpx;
  box-sizing: border-box;
  background: transparent;
}

.mode-tabs {
  display: flex;
  align-items: center;
  gap: 44rpx;
}

.mode-tab {
  color: #74727d;
  font-size: 31rpx;
  font-weight: 650;
}

.mode-tab--active {
  color: var(--roamly-text);
  font-size: 38rpx;
  font-weight: 780;
}

.manage-link {
  display: flex;
  align-items: center;
  gap: 10rpx;
  color: var(--roamly-text);
  font-size: 27rpx;
  font-weight: 560;
}

.identity-wrap {
  overflow: hidden;
}

.shop-name {
  overflow: hidden;
  padding: 22rpx 2rpx 36rpx;
  color: #111019;
  font-size: 42rpx;
  font-weight: 780;
  line-height: 1.25;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.order-search {
  display: flex;
  height: 82rpx;
  align-items: center;
  gap: 18rpx;
  padding: 0 28rpx;
  border-radius: 24rpx;
  color: #aaa8b1;
  background: rgba(255, 255, 255, 0.9);
  font-size: 27rpx;
}

.verify-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 22rpx;
  margin-top: 26rpx;
}

.verify-card {
  display: flex;
  min-width: 0;
  height: 238rpx;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border-radius: 36rpx;
  color: #fff;
  box-shadow: 0 20rpx 44rpx rgba(45, 42, 80, 0.13);
}

.verify-card--scan {
  background: linear-gradient(145deg, #ff8278, var(--roamly-primary));
}

.verify-card--manual {
  background: linear-gradient(145deg, #9b90ff, var(--roamly-accent));
}

.verify-card__icon {
  display: flex;
  height: 80rpx;
  align-items: center;
  justify-content: center;
}

.verify-card__title {
  margin-top: 20rpx;
  font-size: 34rpx;
  font-weight: 760;
}

.home-alert {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  margin-top: 22rpx;
  padding: 20rpx 24rpx;
  border: 1rpx solid rgba(130, 117, 255, 0.18);
  border-radius: 22rpx;
  color: #6358bb;
  background: rgba(255, 255, 255, 0.76);
  font-size: 23rpx;
}

.home-alert--error {
  color: var(--roamly-danger);
}

.home-alert__action {
  flex: none;
  color: var(--roamly-primary);
  font-weight: 700;
}

.home-menu-card {
  display: flex;
  min-height: 132rpx;
  align-items: center;
  gap: 24rpx;
  margin-top: 26rpx;
  padding: 0 36rpx;
  border-radius: 34rpx;
  background: #fff;
  box-shadow: 0 14rpx 38rpx rgba(45, 42, 80, 0.055);
}

.home-menu-card--group {
  display: block;
  padding-top: 8rpx;
  padding-bottom: 8rpx;
}

.home-menu-row {
  display: flex;
  min-height: 116rpx;
  align-items: center;
  gap: 24rpx;
}

.home-menu-icon {
  display: flex;
  width: 72rpx;
  height: 72rpx;
  flex: 0 0 72rpx;
  align-items: center;
  justify-content: center;
  border-radius: 20rpx;
}

.home-menu-icon--purple {
  color: var(--roamly-accent);
  background: rgba(130, 117, 255, 0.12);
}

.home-menu-icon--amber {
  color: #dc7925;
  background: #fff1df;
}

.home-menu-label {
  min-width: 0;
  flex: 1;
  color: #15141c;
  font-size: 32rpx;
  font-weight: 650;
}

.receipt-card {
  position: relative;
  margin-top: 28rpx;
  padding: 34rpx 34rpx 48rpx;
  border-radius: 34rpx 34rpx 0 0;
  background: #fff;
  box-shadow: 0 14rpx 38rpx rgba(45, 42, 80, 0.055);
  transition: background 260ms ease;
}

.receipt-card--flash {
  background: #fff7f5;
}

.receipt-head {
  display: flex;
  min-height: 58rpx;
  align-items: center;
  justify-content: space-between;
}

.receipt-title {
  color: #6f6d77;
  font-size: 30rpx;
}

.receipt-tools {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.receipt-refresh {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #74727d;
}

.receipt-body {
  margin-top: 22rpx;
  padding-top: 24rpx;
  border-top: 1rpx dashed #d9d8e1;
}

.receipt-row {
  display: flex;
  min-height: 64rpx;
  align-items: baseline;
  justify-content: space-between;
  color: #77747f;
  font-size: 28rpx;
}

.receipt-row strong {
  color: #17161e;
  font-size: 34rpx;
  font-weight: 780;
}

.receipt-row small {
  margin-left: 5rpx;
  color: #77747f;
  font-size: 24rpx;
  font-weight: 400;
}

.receipt-note {
  margin-top: 4rpx;
  color: #9b99a3;
  font-size: 21rpx;
}

.receipt-link {
  margin-top: 8rpx;
  color: var(--roamly-accent);
  font-size: 23rpx;
  text-align: right;
}

.receipt-error {
  color: var(--roamly-danger);
  font-size: 22rpx;
}

.receipt-teeth {
  position: absolute;
  right: 0;
  bottom: -12rpx;
  left: 0;
  height: 24rpx;
  background: radial-gradient(
      circle at 12rpx 24rpx,
      transparent 12rpx,
      #fff 13rpx
    )
    0 0 / 24rpx 24rpx repeat-x;
}

.home-loading {
  position: fixed;
  top: 50%;
  left: 50%;
  z-index: 100;
  padding: 18rpx 28rpx;
  border-radius: 22rpx;
  color: var(--roamly-muted);
  background: rgba(255, 255, 255, 0.94);
  box-shadow: var(--roamly-shadow-soft);
  font-size: 23rpx;
  transform: translate(-50%, -50%);
}

@media (width <= 340px) {
  .verify-card {
    height: 212rpx;
  }

  .verify-card__title {
    font-size: 30rpx;
  }

  .home-menu-label {
    font-size: 29rpx;
  }
}
