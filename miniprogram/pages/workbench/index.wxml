<view class="home-page" style="padding-top: {{statusBarHeight}}px;">
  <view class="mode-bar" style="top: {{statusBarHeight}}px; padding-right: {{capsuleInset}}px;">
    <view class="mode-tabs">
      <view class="mode-tab mode-tab--active">到店</view>
    </view>
    <view class="manage-link pressable" bind:tap="openManagement">
      <t-icon name="swap" size="36rpx" />
      <text>去管理版</text>
    </view>
  </view>

  <view class="identity-wrap">
    <view class="shop-name">{{shopName}}</view>
    <view class="order-search pressable" data-label="订单搜索" bind:tap="unavailable">
      <t-icon name="search" size="45rpx" color="#9b99a3" />
      <text>订单有问题？点击搜索查看详情</text>
    </view>
  </view>

  <view wx:if="{{error}}" class="home-alert home-alert--error">
    <text>{{error}}</text>
    <text class="home-alert__action" bind:tap="retry">重新加载</text>
  </view>
  <view wx:elif="{{current && current.status !== 'ACTIVE'}}" class="home-alert">
    <text>当前账号状态：{{current.statusLabel}}</text>
    <text class="home-alert__action" bind:tap="goToMe">前往处理</text>
  </view>

  <view class="verify-grid">
    <view class="verify-card verify-card--scan pressable" bind:tap="scan">
      <view class="verify-card__icon"><t-icon name="scan" size="70rpx" color="#ffffff" /></view>
      <view class="verify-card__title">扫码验券</view>
    </view>
    <view class="verify-card verify-card--manual pressable" bind:tap="manual">
      <view class="verify-card__icon"><t-icon name="keyboard" size="70rpx" color="#ffffff" /></view>
      <view class="verify-card__title">输码验券</view>
    </view>
  </view>

  <view class="home-menu-card pressable" bind:tap="openRedemptions">
    <view class="home-menu-icon home-menu-icon--purple"><t-icon name="check-circle" size="42rpx" /></view>
    <view class="home-menu-label">核销明细</view>
    <t-icon name="chevron-right" size="42rpx" color="#777680" />
  </view>
  <view class="receipt-card today-receipt pressable" bind:tap="openToday">
    <view class="receipt-head"><view class="receipt-title">本店经营资金总计（今日收银）</view><t-icon name="chevron-right" size="42rpx" color="#777680" /></view>
    <view class="receipt-body"><view class="receipt-row"><text>核销金额</text><strong>{{today ? today.redemptionAmountText : "--"}}<small wx:if="{{today}}">元</small></strong></view><view class="receipt-row"><text>退款金额</text><strong>{{today ? today.refundAmountText : "--"}}<small wx:if="{{today}}">元</small></strong></view><view class="receipt-row receipt-row--total"><text>今日净收</text><strong>{{today ? today.netReceiptAmountText : "--"}}<small wx:if="{{today}}">元</small></strong></view><view class="receipt-note">结算记录包含历史批次和冲回调整</view></view><view class="receipt-teeth"></view>
  </view>

  <view class="home-menu-card home-menu-card--group">
    <view class="home-menu-row pressable" bind:tap="openAfterSales">
      <view class="home-menu-icon home-menu-icon--amber"><t-icon name="service" size="42rpx" /></view>
      <view class="home-menu-label">处理售后</view>
      <t-icon name="chevron-right" size="42rpx" color="#777680" />
    </view>
    <view class="home-menu-row pressable" bind:tap="openRefundCreate">
      <view class="home-menu-icon home-menu-icon--amber"><t-icon name="money" size="42rpx" /></view>
      <view class="home-menu-label">发起退款</view>
      <t-icon name="chevron-right" size="42rpx" color="#777680" />
    </view>
  </view>

  <view wx:if="{{loading && !current}}" class="home-loading">正在同步门店信息...</view>
</view>
