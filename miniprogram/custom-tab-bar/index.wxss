.tabbar {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 200;
  display: grid;
  height: calc(128rpx + env(safe-area-inset-bottom));
  grid-template-columns: repeat(3, 1fr);
  padding: 8rpx 60rpx env(safe-area-inset-bottom);
  border-top: 1rpx solid rgba(41, 39, 53, 0.05);
  box-sizing: border-box;
  background: rgba(255, 255, 255, 0.96);
  box-shadow: 0 -6rpx 26rpx rgba(45, 42, 80, 0.05);
  backdrop-filter: blur(24rpx);
}

.tabbar__item {
  display: flex;
  height: 108rpx;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 5rpx;
  color: #92909d;
  font-size: 22rpx;
}

.tabbar__icon {
  display: flex;
  width: 64rpx;
  height: 58rpx;
  align-items: center;
  justify-content: center;
  border-radius: 24rpx;
}

.tabbar__item--active {
  color: #ff5f57;
  font-weight: 650;
}

.tabbar__item--active .tabbar__icon {
  background: rgba(255, 95, 87, 0.11);
}

.pressable:active {
  transform: scale(0.96);
}
