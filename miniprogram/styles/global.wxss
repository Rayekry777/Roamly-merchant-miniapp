page {
  width: 100%;
  min-height: 100%;
  overflow-x: hidden;
  color: var(--roamly-text);
  background: var(--roamly-bg);
  font-family:
    -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei",
    sans-serif;
}

view,
scroll-view,
swiper,
button,
input,
textarea,
label {
  box-sizing: border-box;
}

button,
input,
textarea {
  max-width: 100%;
  font: inherit;
}

button::after {
  border: 0;
}

.page-shell {
  width: 100%;
  max-width: 100%;
  min-height: 100vh;
  overflow-x: hidden;
  padding-top: 28rpx;
  padding-right: 28rpx;
  padding-bottom: calc(148rpx + env(safe-area-inset-bottom));
  padding-left: 28rpx;
  box-sizing: border-box;
}

.page-shell--subpage {
  padding-bottom: calc(48rpx + env(safe-area-inset-bottom));
}

.page-enter {
  animation: roamly-page-in 280ms ease-out both;
}

.page-heading {
  margin: 0;
  font-size: 48rpx;
  font-weight: 750;
  line-height: 1.25;
}

.page-kicker {
  margin-bottom: 10rpx;
  color: var(--roamly-accent);
  font-size: 21rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.page-rule {
  display: flex;
  gap: 12rpx;
  margin-top: 26rpx;
}

.page-rule::before,
.page-rule::after {
  height: 8rpx;
  border-radius: 4rpx;
  content: "";
}

.page-rule::before {
  width: 160rpx;
  background: var(--roamly-primary);
}

.page-rule::after {
  width: 72rpx;
  background: var(--roamly-accent);
}

.section-block,
.state-panel,
.error-panel,
.surface-card {
  max-width: 100%;
  box-sizing: border-box;
  margin-top: 24rpx;
  border: 1rpx solid var(--roamly-border);
  border-radius: var(--roamly-card-radius);
  background: var(--roamly-surface);
  box-shadow: var(--roamly-shadow-soft);
}

.section-block,
.surface-card {
  padding: 30rpx;
}

.section-title {
  color: var(--roamly-text);
  font-size: 29rpx;
  font-weight: 720;
}

.onboarding-note,
.muted-copy {
  margin-top: 8rpx;
  color: var(--roamly-muted);
  font-size: 23rpx;
  line-height: 1.55;
}

.state-panel,
.error-panel {
  padding: 42rpx 30rpx;
  color: var(--roamly-muted);
  font-size: 25rpx;
  line-height: 1.55;
  text-align: center;
}

.error-panel {
  color: var(--roamly-danger);
}

.primary-action,
.secondary-action,
.text-action {
  border-radius: var(--roamly-control-radius);
  font-size: 27rpx;
  font-weight: 700;
}

.primary-action {
  color: #ffffff;
  background: linear-gradient(135deg, #ff756c, var(--roamly-primary));
  box-shadow: 0 12rpx 28rpx rgba(255, 95, 87, 0.22);
}

.secondary-action {
  border: 1rpx solid var(--roamly-border);
  color: var(--roamly-text);
  background: #ffffff;
}

.text-action {
  color: var(--roamly-primary);
  background: transparent;
}

.pressable {
  transition:
    transform 140ms ease,
    opacity 140ms ease;
}

.pressable:active {
  transform: scale(0.975);
  opacity: 0.88;
}

.list-footer {
  padding: 32rpx 0;
  color: var(--roamly-muted);
  font-size: 23rpx;
  text-align: center;
}

@keyframes roamly-page-in {
  from {
    transform: translateY(12rpx);
    opacity: 0;
  }

  to {
    transform: translateY(0);
    opacity: 1;
  }
}
