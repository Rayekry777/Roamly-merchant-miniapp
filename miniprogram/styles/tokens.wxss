  --roamly-primary: #ff5f57;
  --roamly-primary-active: #e94f49;
  --roamly-accent: #8275ff;
  --roamly-text: #242331;
  --roamly-muted: #8f8d99;
  --roamly-bg: #f4f5fb;
  --roamly-surface: #ffffff;
  --roamly-border: #ececf3;
  --roamly-control-radius: 32rpx;
  --roamly-card-radius: 48rpx;
  --roamly-shadow: 0 20rpx 56rpx rgba(45, 42, 80, 0.1);
  --roamly-shadow-soft: 0 12rpx 36rpx rgba(45, 42, 80, 0.07);
  --roamly-success: #28a47c;
  --roamly-warning: #f39a3f;
  --roamly-danger: #d84d49;
  --td-brand-color: #ff5f57;
  --td-brand-color-active: #e94f49;
